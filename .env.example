# Public — safe for browser (VITE_ prefix)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server only — never expose to client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — for npm run supabase:fix-rls (Database → Connection string URI)
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# Razorpay (required for join-page checkout)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional: existing Razorpay Plan ID for ₹6999/month autopay (else created via API)
# RAZORPAY_PLAN_ID_MONTHLY=plan_xxxxx
# Set to 0 to force one-time orders only (no subscriptions)
# RAZORPAY_SUBSCRIPTIONS=1

# Cron secret for GET/POST /api/cron/membership (renewal reminders + grace expiry)
CRON_SECRET=

# Manual payment fallback
PAYMENT_UPI_ID=
PAYMENT_INSTRUCTIONS=

# App URL for redirects
APP_URL=https://www.leanmovement.in
