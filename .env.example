# Public — safe for browser (VITE_ prefix)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server only — never expose to client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — for npm run supabase:fix-rls (Database → Connection string URI)
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# Razorpay (enable when client account is ready)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Manual payment fallback (shown on /portal/checkout until Razorpay is live)
PAYMENT_UPI_ID=
PAYMENT_INSTRUCTIONS=

# App URL for redirects
APP_URL=http://localhost:8080
