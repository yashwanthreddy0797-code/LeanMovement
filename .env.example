# Public — safe for browser (VITE_ prefix)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server only — never expose to client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — for npm run supabase:fix-rls / supabase:chat (Database → Connection string URI)
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# Razorpay (required for join-page checkout)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Recommended: pin an existing Razorpay Plan ID for ₹6969/month autopay (faster checkout).
# Without this, the server creates/caches a plan via API on first payment.
# RAZORPAY_PLAN_ID_MONTHLY=plan_xxxxx
# Set to 0 to force one-time orders only (no subscriptions / no “until 20xx” Razorpay copy).
# Required for Razorpay test keys if the account does not have recurring payments enabled.
# RAZORPAY_SUBSCRIPTIONS=0

# Cron secret for GET/POST /api/cron/membership and /api/cron/zoom-recordings
CRON_SECRET=

# Zoom cloud recording sync (Server-to-Server OAuth app)
# Create at https://marketplace.zoom.us → Develop → Build App → Server-to-Server OAuth
# Scopes: cloud_recording:read:list_user_recordings:admin (or recording:read:admin)
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# ZOOM_HOST_EMAIL=coach@leanmovement.in

# Manual payment fallback
PAYMENT_UPI_ID=
PAYMENT_INSTRUCTIONS=

# App URL for redirects
APP_URL=https://www.leanmovement.in

# Optional — default Calendly onboarding event (if not set in Coach → Settings)
# Copy link from Calendly event "LeanMovement - Onboarding Call with Coach"
# VITE_CALENDLY_ONBOARDING_URL=https://calendly.com/coach-leanmovement/30min

# Optional — contact form + member welcome email after payment (recommended)
# 1) Resend: verify leanmovement.in at https://resend.com/domains
# RESEND_API_KEY=re_xxxxx
# RESEND_FROM_EMAIL=LEANMOVEMENT <hello@leanmovement.in>
# Welcome email sends automatically after first Razorpay payment when both keys are set.
#
# 2) Web3Forms (simple fallback): create a free key at https://web3forms.com
# Set the destination email to coach@leanmovement.in
# WEB3FORMS_ACCESS_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#
# Without either key, FormSubmit is used. On first use, coach@leanmovement.in
# receives an activation email — click "Activate Form" once.

# One-time: run supabase/contact-messages.sql in Supabase SQL Editor
# so contact form messages are stored and visible on Coach dashboard.
