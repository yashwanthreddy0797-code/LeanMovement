# Public — safe for browser (VITE_ prefix)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server only — never expose to client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — for npm run supabase:fix-rls (Database → Connection string URI)
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# Razorpay (required for join-page checkout)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Recommended: pin an existing Razorpay Plan ID for ₹6999/month autopay (faster checkout).
# Without this, the server creates/caches a plan via API on first payment.
# RAZORPAY_PLAN_ID_MONTHLY=plan_xxxxx
# Set to 0 to force one-time orders only (no subscriptions / no “until 20xx” Razorpay copy).
# Required for Razorpay test keys if the account does not have recurring payments enabled.
# RAZORPAY_SUBSCRIPTIONS=0

# Cron secret for GET/POST /api/cron/membership and /api/cron/zoom-recordings
CRON_SECRET=

# Zoom cloud recording sync (Server-to-Server OAuth app)
# Create at https://marketplace.zoom.us → Develop → Build App → Server-to-Server OAuth
# Scopes: cloud_recording:read:list_user_recordings:admin (or recording:read:admin)
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# ZOOM_HOST_EMAIL=coach@leanmovement.in

# Manual payment fallback
PAYMENT_UPI_ID=
PAYMENT_INSTRUCTIONS=

# App URL for redirects
APP_URL=https://www.leanmovement.in

# Optional — contact form email delivery (preferred)
# Without this, messages still save to Supabase + FormSubmit fallback to coach@leanmovement.in
# RESEND_API_KEY=re_xxxxx
# RESEND_FROM_EMAIL=LEANMOVEMENT <hello@leanmovement.in>

# One-time: run supabase/contact-messages.sql in Supabase SQL Editor
# so contact form messages are stored and visible on Coach dashboard.
